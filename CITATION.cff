    orcid: "https://orcid.org/0000-0001-6829-0823"
repository-code: "https://github.com/choxos/krt"
url: "https://choxos.github.io/krt/"
license: GPL-3.0-only
version: 0.1.0
keywords:
  - key resources table
  - KRT
  - RRID
  - reproducibility
  - FAIR
  - research resources
  - R
